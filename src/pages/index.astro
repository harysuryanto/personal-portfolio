---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import SkillsMatrix from '../components/SkillsMatrix.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import CaseStudyDrawer from '../components/CaseStudyDrawer.astro';
---

<BaseLayout>
  <!-- Hero Section -->
  <Hero />

  <!-- Selected Work / Flagship Showcase -->
  <ProjectsSection />

  <!-- Technical Skills & Architecture Matrix -->
  <SkillsMatrix />

  <!-- Experience & Production Milestones -->
  <Experience />

  <!-- Direct Contact & Socials -->
  <Contact />

  <!-- Slide-Over Case Study Drawer Modal -->
  <CaseStudyDrawer />
</BaseLayout>
