---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

const flagship = projects.find((p) => p.isFlagship);
const companionProjects = projects.filter((p) => !p.isFlagship);
---

<section id="work" class="py-16 md:py-24 border-t border-zinc-900 scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-2xl mb-12">
      <div class="flex items-center gap-2 text-xs font-mono text-emerald-400 uppercase tracking-wider mb-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>Featured Case Studies</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Production Engineering & Client Systems
      </h2>
      <p class="text-sm sm:text-base text-zinc-400 mt-2">
        Real-world client architectures solving hardware camera bottlenecks, Bluetooth RF telemetry, and offline-first finance pipelines.
      </p>
    </div>

    <!-- Flagship Showcase -->
    {flagship && (
      <div class="mb-10">
        <ProjectCard project={flagship} />
      </div>
    )}

    <!-- Secondary Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {companionProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</section>
