---
import { siteConfig } from '../data/siteConfig';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/90 border border-zinc-800 text-xs font-mono text-zinc-300 mb-8 backdrop-blur shadow-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>{siteConfig.status.label}</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.1]">
        Engineering resilient <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400">mobile systems</span> & native hardware interfaces.
      </h1>

      <!-- Bio / Tagline -->
      <p class="mt-6 text-lg sm:text-xl text-zinc-400 leading-relaxed max-w-2xl">
        I'm <strong class="text-zinc-200 font-semibold">{siteConfig.name}</strong>, a mobile engineer building high-performance client applications. Specializing in <span class="text-zinc-200">Flutter</span>, <span class="text-zinc-200">Swift / macOS</span>, and <span class="text-zinc-200">React Native</span>, with deep experience in hardware camera integration, offline-first data sync, and Clean Architecture.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="#work"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-sm font-semibold bg-emerald-500 text-zinc-950 hover:bg-emerald-400 transition-all duration-150 shadow-lg shadow-emerald-500/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
        >
          <span>Explore Featured Work</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>

        <a
          href="#contact"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-sm font-semibold bg-zinc-900 text-zinc-200 hover:text-white hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
        >
          <span>Get in Touch</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>

        <a
          href={siteConfig.socials.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-sm font-medium text-zinc-400 hover:text-zinc-100 hover:bg-zinc-900 transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          <span class="font-mono text-xs">@harysuryanto</span>
        </a>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="mt-14 pt-8 border-t border-zinc-800/80 grid grid-cols-2 sm:grid-cols-3 gap-6">
        <div>
          <div class="text-2xl font-bold font-mono text-white">Flutter & Native</div>
          <div class="text-xs text-zinc-400 mt-1">Multi-Platform Desktop & Mobile</div>
        </div>
        <div>
          <div class="text-2xl font-bold font-mono text-emerald-400">OTA & Live Kiosks</div>
          <div class="text-xs text-zinc-400 mt-1">Shorebird Fleet Code Push</div>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <div class="text-2xl font-bold font-mono text-cyan-400">Clean Architecture</div>
          <div class="text-xs text-zinc-400 mt-1">Offline-first local cache & sync</div>
        </div>
      </div>
    </div>
  </div>
</section>
