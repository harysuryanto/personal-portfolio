---
import { siteConfig } from '../data/siteConfig';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-900 bg-zinc-950 text-zinc-400 py-12 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <!-- Brand & Tagline -->
      <div class="flex flex-col items-center sm:items-start text-center sm:text-left">
        <div class="flex items-center gap-2">
          <span class="font-mono font-bold text-zinc-100 tracking-tight">{siteConfig.name}</span>
          <span class="text-zinc-600">/</span>
          <span class="text-xs font-mono text-zinc-400">Mobile Engineer</span>
        </div>
        <p class="text-xs text-zinc-500 mt-1 max-w-sm">
          High-performance client architectures, hardware/camera integration, and clean codebases.
        </p>
      </div>

      <!-- Social & Anchors -->
      <div class="flex items-center gap-4 text-xs font-medium">
        <a
          href={siteConfig.socials.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-400 hover:text-zinc-100 transition-colors"
        >
          GitHub
        </a>
        <span class="text-zinc-800">•</span>
        <a
          href={siteConfig.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-400 hover:text-zinc-100 transition-colors"
        >
          LinkedIn
        </a>
        <span class="text-zinc-800">•</span>
        <a
          href={siteConfig.socials.email}
          class="text-zinc-400 hover:text-emerald-400 transition-colors"
        >
          Email
        </a>
        <span class="text-zinc-800">•</span>
        <a
          href="#work"
          class="text-zinc-400 hover:text-zinc-100 transition-colors"
        >
          Back to Top ↑
        </a>
      </div>
    </div>

    <!-- Tech stamp & Copyright -->
    <div class="mt-8 pt-6 border-t border-zinc-900/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-zinc-500 font-mono">
      <span>© {currentYear} {siteConfig.name}. All rights reserved.</span>
      <div class="flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>Astro 7 SSG • Tailwind v4 • GitHub Pages</span>
      </div>
    </div>
  </div>
</footer>
