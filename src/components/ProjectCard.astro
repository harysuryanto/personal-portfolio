---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

{project.isFlagship ? (
  <article data-project-card data-filter={project.filterTag} class="relative rounded-2xl bg-gradient-to-b from-zinc-900/90 to-zinc-950 border border-emerald-500/30 p-6 sm:p-8 shadow-xl shadow-emerald-950/20 hover:border-emerald-500/50 transition-all duration-300">
    <div class="flex flex-col lg:flex-row gap-8 items-start justify-between">
      <div class="flex-1 space-y-4">
        <!-- Badges -->
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Flagship Production Project
          </span>
          <span class="text-xs font-mono text-zinc-400 px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-800">
            {project.category}
          </span>
        </div>

        <!-- Title & Tagline -->
        <div>
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            {project.title}
          </h3>
          <p class="text-sm sm:text-base text-zinc-400 mt-1 font-medium">
            {project.tagline}
          </p>
        </div>

        <!-- Summary -->
        <p class="text-sm text-zinc-300 leading-relaxed max-w-2xl">
          {project.summary}
        </p>

        <!-- Tech Stack Badges -->
        <div class="flex flex-wrap gap-1.5 pt-2">
          {project.techStack.map((tech) => (
            <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-zinc-900 text-zinc-300 border border-zinc-800">
              {tech}
            </span>
          ))}
        </div>

        <!-- Metrics Row -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-3">
          {project.metrics.map((m) => (
            <div class="p-3 rounded-xl bg-zinc-900/70 border border-zinc-800/80">
              <div class="text-sm sm:text-base font-bold font-mono text-emerald-400">{m.value}</div>
              <div class="text-[11px] text-zinc-400 mt-0.5">{m.label}</div>
            </div>
          ))}
        </div>

        <!-- Action CTAs -->
        <div class="pt-4 flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-case-study={project.id}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-semibold bg-emerald-500 text-zinc-950 hover:bg-emerald-400 transition-all duration-150 shadow-md shadow-emerald-500/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 cursor-pointer"
          >
            <span>Read Architectural Case Study</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

          {project.githubUrl && (
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-medium bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border border-zinc-800 hover:border-zinc-700 transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              <span>Custom Fork / Code</span>
            </a>
          )}
        </div>
      </div>

      <!-- Architecture Blueprint Mockup Panel -->
      <div class="w-full lg:w-72 rounded-xl bg-zinc-950 border border-zinc-800/90 p-4 font-mono text-[11px] text-zinc-400 space-y-3 shadow-inner">
        <div class="flex items-center justify-between pb-2 border-b border-zinc-800 text-zinc-400">
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Kiosk Architecture
          </span>
          <span class="text-zinc-400">v1.2.1</span>
        </div>
        <div class="space-y-1.5 text-zinc-400">
          <div class="flex justify-between">
            <span class="text-zinc-400">UI Engine:</span>
            <span class="text-zinc-200">Flutter / Riverpod</span>
          </div>
          <div class="flex justify-between">
            <span class="text-zinc-400">HAL Camera:</span>
            <span class="text-emerald-400">WebRTC + MJPEG</span>
          </div>
          <div class="flex justify-between">
            <span class="text-zinc-400">Fleet Patch:</span>
            <span class="text-cyan-400">Shorebird OTA</span>
          </div>
          <div class="flex justify-between">
            <span class="text-zinc-400">Shaders:</span>
            <span class="text-zinc-200">3D LUT Filters</span>
          </div>
          <div class="flex justify-between">
            <span class="text-zinc-400">Print Engine:</span>
            <span class="text-zinc-200">Thermal Spooler</span>
          </div>
        </div>
        <div class="pt-2 border-t border-zinc-800/80 text-[10px] text-zinc-400 leading-tight">
          Unattended kiosk client deployed in retail malls with automated fault recovery.
        </div>
      </div>
    </div>
  </article>
) : (
  <article data-project-card data-filter={project.filterTag} class="rounded-2xl bg-zinc-900/60 border border-zinc-800/80 p-6 flex flex-col justify-between hover:border-zinc-700 transition-all duration-200 hover:shadow-lg hover:shadow-zinc-950/40">
    <div class="space-y-4">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs font-mono text-zinc-400 px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-800">
          {project.category}
        </span>
        <div class="flex gap-1.5">
          {project.platforms.map((plat) => (
            <span class="text-[11px] font-mono text-zinc-400 bg-zinc-950 px-2 py-0.5 rounded border border-zinc-800/60">
              {plat}
            </span>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-xl font-bold text-white tracking-tight">{project.title}</h3>
        <p class="text-xs text-zinc-400 mt-1 font-medium">{project.tagline}</p>
      </div>

      <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
        {project.summary}
      </p>

      <!-- Tech Badges -->
      <div class="flex flex-wrap gap-1.5 pt-1">
        {project.techStack.slice(0, 5).map((tech) => (
          <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-950 text-zinc-400 border border-zinc-800">
            {tech}
          </span>
        ))}
        {project.techStack.length > 5 && (
          <span class="px-2 py-0.5 rounded text-[11px] font-mono text-zinc-400">
            +{project.techStack.length - 5} more
          </span>
        )}
      </div>

      <!-- Metrics Row -->
      <div class="grid grid-cols-2 gap-2 pt-2">
        {project.metrics.slice(0, 2).map((m) => (
          <div class="p-2.5 rounded-lg bg-zinc-950/80 border border-zinc-800/70">
            <div class="text-xs font-bold font-mono text-emerald-400">{m.value}</div>
            <div class="text-[10px] text-zinc-400 mt-0.5">{m.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Actions -->
    <div class="pt-6 flex items-center justify-between gap-3 border-t border-zinc-800/60 mt-6">
      <button
        type="button"
        data-case-study={project.id}
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 hover:text-emerald-300 transition-colors focus:outline-none focus-visible:underline cursor-pointer"
      >
        <span>Inspect Case Study</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      {project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-400 hover:text-white transition-colors p-1"
          aria-label={`${project.title} GitHub repository`}
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </a>
      )}
    </div>
  </article>
)}
