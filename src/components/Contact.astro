---
import { siteConfig } from '../data/siteConfig';
---

<section id="contact" class="py-20 md:py-28 border-t border-zinc-900 scroll-mt-16 relative overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Header -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-xs font-mono text-emerald-400 mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
      <span>Let's Build Something Exceptional</span>
    </div>

    <h2 class="text-3xl sm:text-5xl font-bold text-white tracking-tight">
      Have a mobile client or hardware system to ship?
    </h2>

    <p class="mt-4 text-base sm:text-lg text-zinc-400 max-w-2xl mx-auto leading-relaxed">
      Whether you need to architect a new Flutter/Swift product, integrate complex peripheral hardware, or optimize an existing mobile client, I'm available for technical discussions and senior engineering opportunities.
    </p>

    <!-- Email Card with Copy Feature -->
    <div class="mt-10 p-6 sm:p-8 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 max-w-xl mx-auto backdrop-blur-sm shadow-xl shadow-zinc-950/40">
      <div class="text-xs font-mono text-zinc-400 uppercase tracking-wider mb-2">Direct Contact</div>
      <div class="text-lg sm:text-xl font-mono font-bold text-white break-all mb-6">
        {siteConfig.email}
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <!-- Direct Mailto -->
        <a
          href={siteConfig.socials.email}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-xs font-semibold bg-emerald-500 text-zinc-950 hover:bg-emerald-400 transition-all duration-150 shadow-md shadow-emerald-500/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Open Email Client</span>
        </a>

        <!-- Copy Email Button -->
        <button
          id="copy-email-btn"
          type="button"
          data-email={siteConfig.email}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-xs font-medium bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span id="copy-btn-text">Copy Email Address</span>
        </button>
      </div>

      <!-- Toast Notification -->
      <div id="copy-toast" class="hidden mt-4 text-xs font-mono text-emerald-400 transition-opacity duration-200">
        ✓ Email address copied to clipboard!
      </div>
    </div>

    <!-- Social links -->
    <div class="mt-8 flex items-center justify-center gap-6 text-sm text-zinc-400">
      <a
        href={siteConfig.socials.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-white transition-colors flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
        <span>GitHub Profile</span>
      </a>
      <span class="text-zinc-700">•</span>
      <a
        href={siteConfig.socials.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-white transition-colors"
      >
        LinkedIn
      </a>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const btnText = document.getElementById('copy-btn-text');
  const toast = document.getElementById('copy-toast');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email');
    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);
      if (btnText) btnText.textContent = 'Copied!';
      toast?.classList.remove('hidden');

      setTimeout(() => {
        if (btnText) btnText.textContent = 'Copy Email Address';
        toast?.classList.add('hidden');
      }, 3000);
    } catch {
      // Fallback
      if (btnText) btnText.textContent = 'Failed to copy';
    }
  });
</script>
