---
import { skillCategories } from '../data/skills';
---

<section id="skills" class="py-16 md:py-24 border-t border-zinc-900 scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-2xl mb-12">
      <div class="flex items-center gap-2 text-xs font-mono text-cyan-400 uppercase tracking-wider mb-2">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        <span>Technical Arsenal</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Architecture, Protocols & Native SDKs
      </h2>
      <p class="text-sm sm:text-base text-zinc-400 mt-2">
        Core competencies spanning multi-platform mobile frameworks, camera/RF hardware integrations, and testable domain architectures.
      </p>
    </div>

    <!-- Skills Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {skillCategories.map((cat) => (
        <div class="rounded-2xl bg-zinc-900/40 border border-zinc-800/80 p-6 flex flex-col justify-between">
          <div>
            <h3 class="text-lg font-bold text-white tracking-tight flex items-center justify-between">
              <span>{cat.title}</span>
            </h3>
            <p class="text-xs text-zinc-400 mt-1 mb-5 leading-relaxed">
              {cat.description}
            </p>

            <div class="flex flex-wrap gap-2">
              {cat.skills.map((skill) => (
                <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono bg-zinc-950 border border-zinc-800/90 text-zinc-300 hover:border-zinc-700 hover:text-white transition-colors">
                  <span>{skill.name}</span>
                  {skill.badge && (
                    <span class="text-[10px] px-1.5 py-0.2 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-semibold">
                      {skill.badge}
                    </span>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
